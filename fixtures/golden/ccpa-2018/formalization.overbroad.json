{
  "id": "LHP-001",
  "version": 3,
  "sourceId": "ccpa-2018-ab375",
  "vars": [
    { "name": "annual_revenue_musd", "label": "Annual revenue (million USD)", "spanIds": ["S1"], "origin": "source", "sort": "int", "min": 0, "max": 1000 },
    { "name": "consumers_k", "label": "Consumers, households, or devices (thousands)", "spanIds": ["S1"], "origin": "source", "sort": "int", "min": 0, "max": 10000 },
    { "name": "pi_revenue_pct", "label": "Percent of annual revenue from selling PI", "spanIds": ["S1"], "origin": "source", "sort": "int", "min": 0, "max": 100 },
    { "name": "discloses_pi", "label": "Discloses personal information", "spanIds": ["S2"], "origin": "source", "sort": "bool" },
    { "name": "recipient", "label": "Recipient of the disclosure", "spanIds": ["S2", "S3", "S4"], "origin": "source", "sort": "enum", "values": ["third_party", "service_provider", "consumer_directed"] },
    { "name": "consideration", "label": "Consideration received for the disclosure", "spanIds": ["S2"], "origin": "source", "sort": "enum", "values": ["money", "other_valuable", "none"] },
    { "name": "disclosure_purpose", "label": "Purpose of the disclosure", "spanIds": ["S4"], "origin": "source", "sort": "enum", "values": ["cross_context_ads", "business_purpose"] },
    { "name": "sp_contract", "label": "Written service-provider contract in place", "spanIds": ["S4"], "origin": "source", "sort": "bool" },
    { "name": "opt_out_link", "label": "\"Do Not Sell My Personal Information\" link provided", "spanIds": ["S5"], "origin": "source", "sort": "bool" },
    { "name": "consumer_opted_out", "label": "Consumer has directed the business not to sell", "spanIds": ["S6", "S7"], "origin": "source", "sort": "bool" }
  ],
  "definitions": [
    {
      "name": "covered_business",
      "label": "Covered business",
      "formula": "or(gt(annual_revenue_musd, 25), ge(consumers_k, 50), ge(pi_revenue_pct, 50))",
      "spanIds": ["S1"],
      "status": "approved",
      "plain": "A business that meets the revenue, consumer-count, or PI-revenue-share threshold."
    }
  ],
  "rules": [
    {
      "id": "R1",
      "kind": "duty",
      "label": "Opt-out link duty (unchanged)",
      "when": "and(covered_business, discloses_pi)",
      "require": "opt_out_link",
      "spanIds": ["S5"],
      "status": "approved",
      "plain": "A covered business that discloses personal information must provide a \"Do Not Sell\" link."
    },
    {
      "id": "R2''",
      "kind": "prohibition",
      "label": "Overbroad: no disclosure at all after opt-out",
      "when": "consumer_opted_out",
      "require": "not(discloses_pi)",
      "spanIds": ["S6", "S7"],
      "status": "approved",
      "plain": "A lazy fix that bans all disclosure after opt-out, regardless of recipient or purpose. Intended to fail the legitimate-use suite."
    }
  ]
}
