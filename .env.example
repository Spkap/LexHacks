# Copy this file to .env.local for local development. Never commit real values.
# Server-only variables: do not prefix secrets with NEXT_PUBLIC_.

# Neon Postgres connection string (use the pooled URL at runtime).
DATABASE_URL=

# Direct model providers, no AI Gateway. Groq is primary; OpenRouter is fallback only.
GROQ_API_KEY=
OPENROUTER_API_KEY=
REASONING_MODEL=openai/gpt-oss-120b
FAST_MODEL=llama-3.1-8b-instant
# Fallback only (plain try/catch in callStructured), not primary path.
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional server-side credentials for the live bill-import path.
CONGRESS_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
